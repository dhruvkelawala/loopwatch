{
  "name": "loopwatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "adapter:claude": "tsx scripts/adapter-claude.ts",
    "adapter:sources": "tsx scripts/adapter-sources.ts",
    "adapter:codex": "tsx scripts/adapter-codex.ts",
    "adapter:pi": "tsx scripts/adapter-pi.ts",
    "adapter:build": "esbuild scripts/adapter-sources.ts scripts/adapter-claude.ts scripts/adapter-codex.ts scripts/adapter-pi.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --out-extension:.js=.mjs",
    "build": "flue build --target node && pnpm adapter:build",
    "dev": "flue dev --target node",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "ui:tsc": "tsc -p ui/tsconfig.json --noEmit",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "adapter:check": "tsx scripts/check-claude-adapter.ts",
    "codex:check": "tsx scripts/check-codex-adapter.ts",
    "pi:check": "tsx scripts/check-pi-adapter.ts",
    "events:check": "tsx scripts/check-normalized-event.ts",
    "source:check": "tsx scripts/check-source-parity.ts",
    "codex:oauth:check": "tsx scripts/check-codex-oauth.ts",
    "ingest:check": "tsx scripts/check-claude-ingest.ts",
    "security:check": "tsx scripts/check-engine-security.ts",
    "evidence:privacy:check": "tsx scripts/check-evidence-privacy.ts",
    "cockpit:check": "tsx scripts/check-cockpit-live.ts",
    "convergence:check": "tsx scripts/check-convergence-watcher.ts",
    "git:check": "tsx scripts/check-scoped-git-watcher.ts",
    "loop:check": "tsx scripts/check-loop-library.ts",
    "alerting:check": "cargo test alerting::tests --manifest-path src-tauri/Cargo.toml",
    "cockpit:caps:check": "tsx scripts/check-cockpit-capabilities.ts",
    "persistence:check": "tsx scripts/check-flue-persistence.ts",
    "v1:baseline": "tsx scripts/check-v1-baseline.ts",
    "v1:harness": "pnpm harness:fixtures && pnpm harness:source-smoke && pnpm harness:eval:live",
    "harness:fixtures": "tsx scripts/check-harness-foundation.ts",
    "harness:source-smoke": "tsx scripts/check-source-smoke.ts",
    "harness:eval:live": "tsx scripts/check-live-eval.ts",
    "e2e:cockpit": "tsx scripts/run-cockpit-e2e.ts",
    "upgrades:check": "tsx scripts/check-upgrades-inbox.ts",
    "dev:data:reset": "tsx scripts/reset-dev-data.ts",
    "test": "tsx scripts/check-normalized-event.ts && tsx scripts/check-claude-adapter.ts && tsx scripts/check-codex-adapter.ts && tsx scripts/check-pi-adapter.ts && tsx scripts/check-cockpit-capabilities.ts",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@flue/react": "1.0.0-beta.9",
    "@flue/runtime": "1.0.0-beta.9",
    "@flue/sdk": "1.0.0-beta.9",
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/geist-sans": "^5.2.5",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.101.1",
    "flue-codex-oauth": "file:vendor/flue-codex-oauth-0.0.1.tgz",
    "hono": "^4.12.27",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.1",
    "valibot": "^1.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@flue/cli": "1.0.0-beta.9",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "2.11.3",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "0.28.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
